<div id="<%= dom_id review %>">
  <div><strong>
      <%= review.user.username %>
    </strong></div>

  <div>
    <strong>Rating:</strong>
    <%= review.rating %>/10
  </div>

  <div>
    <strong>Content:</strong>
    <%= review.content %>
  </div>
  <div>
    <%= time_tag review.updated_at, "data-local": "time-ago" %>
  </div>
  <br>
</div>
<% if review.user == Current.user %>
  <%= link_to "Edit", edit_review_path(review) %>
  <%= link_to "Remove",
  movie_review_path(review.movie, review),
  data: {
    turbo_method: :delete,
    turbo_confirm: "Remove this review?",
  } %>
<% end %>
