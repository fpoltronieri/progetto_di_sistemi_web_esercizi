<article id="<%= dom_id movie %>">
  <div>
    <strong>Title:</strong>
    <%= movie.title %>
  </div>

  <div>
    <%= if movie.poster.attached?
      image_tag movie.poster.variant(resize_to_fit: [400, 600])
    end %>
  </div>

  <div>
    <strong>Director:</strong>
    <%= movie.director %>
  </div>

  <div>
    <strong>Duration:</strong>
    <%= movie.duration %>
  </div>

  <div>
    <strong>Plot:</strong>
    <%= movie.plot %>
  </div>

  <div>
    <strong>Location:</strong>
    <%= movie.location %>
  </div>

  <h3>Castings</h3>
  <%= render movie.castings if movie.castings %>
  <%= render "castings/form", movie: movie %>

  <h3>Reviews</h3>
  <% if movie.reviews.length > 0 %>
    <h4>Average Rating:
      <%= movie.average_rating %>/10
    </h4>
  <% end %>
  <%= render movie.reviews if movie.reviews.any? %>
  <%= render "reviews/form", movie: movie %>

</article>
